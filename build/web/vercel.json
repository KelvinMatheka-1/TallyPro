{
  "version": 2,
  "routes": [
    {
      "src": "^/flutter_service_worker.js",
      "headers": { "cache-control": "no-cache" },
      "dest": "/flutter_service_worker.js"
    },
    {
      "src": "^/version.json",
      "headers": { "cache-control": "no-cache" },
      "dest": "/version.json"
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/canvaskit/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/canvaskit/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}